{
  "version": 2,
  "media": {
    "screenVideoPath": "voice-typing-source.mp4",
    "cursorCaptureMode": "system"
  },
  "editor": {
    "wallpaper": "#272823",
    "shadowIntensity": 0,
    "showBlur": false,
    "motionBlurAmount": 0,
    "borderRadius": 0,
    "padding": 0,
    "cropRegion": { "x": 0, "y": 0, "width": 1, "height": 1 },
    "aspectRatio": "16:9",
    "webcamLayoutPreset": "no-webcam",
    "autoZoomEnabled": true,
    "autoFocusAll": false,
    "zoomRegions": [
      { "id": "listening-transcribing", "startMs": 0, "endMs": 4800, "depth": 6, "focus": { "cx": 0.4947916667, "cy": 0.5 }, "focusMode": "manual", "source": "manual" },
      { "id": "inserted-text", "startMs": 5800, "endMs": 10000, "depth": 5, "focus": { "cx": 0.2083333333, "cy": 0.5 }, "focusMode": "manual", "source": "manual" }
    ],
    "trimRegions": [],
    "speedRegions": [],
    "annotationRegions": [],
    "exportFormat": "gif",
    "exportQuality": "source",
    "gifFrameRate": 30,
    "gifLoop": true,
    "gifSizePreset": "medium"
  }
}
